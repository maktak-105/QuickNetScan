#include <windows.h>

#define IDI_ICON1 101
#define IDR_INDEX_HTML 201
#define IDR_ENGINE_DLL 202
#define IDR_WV2_LOADER 203
#define IDR_APP_WASM   204

// Application Icon
IDI_ICON1 ICON "QuickNetScan.ico"

// Embedded self-contained HTML, Go WASM binary, Go Engine DLL, and WebView2Loader DLL
IDR_INDEX_HTML RCDATA "../../build/intermediate/index_embed.html"
IDR_ENGINE_DLL RCDATA "../../build/intermediate/engine_x64.dll"
IDR_WV2_LOADER RCDATA "../../build/intermediate/WebView2Loader.dll"
IDR_APP_WASM   RCDATA "../../build/intermediate/app.wasm"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "maktak-105"
            VALUE "FileDescription",  "QuickNetScan"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "QuickNetScan"
            VALUE "LegalCopyright",   "Copyright (c) 2026 maktak-105"
            VALUE "OriginalFilename", "QuickNetScan.exe"
            VALUE "ProductName",      "QuickNetScan"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
